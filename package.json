{
  "name": "doros-supa",
  "version": "1.0.0",
  "description": "Crush Quest (Doros) - Supabase Migration",
  "private": true,
  "type": "module",
  "main": "electron-dist/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "desktop:dev": "concurrently -k -n vite,tsc,electron \"vite\" \"tsc -p electron -w --preserveWatchOutput\" \"wait-on http://localhost:5173 electron-dist/main.js && DOROS_URL=http://localhost:5173 env -u ELECTRON_RUN_AS_NODE electron .\"",
    "desktop:build": "tsc -p electron && electron-builder --mac"
  },
  "dependencies": {
    "@react-oauth/google": "^0.5.1",
    "@sentry/react": "^8.47.0",
    "@supabase/supabase-js": "^2.39.0",
    "@tanstack/react-query": "^5.0.0",
    "date-fns": "^2.29.3",
    "heic2any": "^0.0.4",
    "jwt-decode": "^3.1.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^4.7.1",
    "react-loader-spinner": "^5.3.4",
    "react-router-dom": "^6.5.0",
    "react-timer-hook": "^3.0.8",
    "recharts": "^3.6.0",
    "uuid": "^9.0.0",
    "web-vitals": "^2.1.4"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@types/styled-components": "^5.1.36",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/ui": "^3.2.4",
    "autoprefixer": "^10.4.13",
    "concurrently": "^10.0.7",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "jsdom": "^27.0.1",
    "postcss": "^8.4.20",
    "tailwindcss": "^3.2.4",
    "tsx": "^4.7.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^3.2.4",
    "wait-on": "^9.5.1"
  }
}
